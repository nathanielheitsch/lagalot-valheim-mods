<Project>

  <!-- Shared MSBuild props for every mod under mods/.
       Each mod's .csproj targets net48 and references the libs/ folder. -->

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

    <!-- Valheim runs on .NET Framework 4.8. -->
    <TargetFramework>net48</TargetFramework>

    <!-- Reference assemblies let us build net48 on macOS without the runtime. -->
    <EnableImplicitNetFrameworkAssemblies>false</EnableImplicitNetFrameworkAssemblies>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyOriginatorKeyFile></AssemblyOriginatorKeyFile>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- One DLL per mod; no app host needed. -->
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Resolved per-repo so all mods share libs/. -->
    <RepoRoot Condition=" '$(RepoRoot)' == '' ">$(MSBuildThisFileDirectory)</RepoRoot>
    <LibsDir>$(RepoRoot)libs</LibsDir>
  </PropertyGroup>

  <!-- Shared package versions; mods just add PackageReference without Version. -->
  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.30.1" />
  </ItemGroup>
  

  <ItemGroup>
    <!-- Lets `dotnet build` find net48 reference assemblies on macOS/Linux. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- BepInEx core (extracted by scripts/fetch-libs.sh into libs/bepinex/).
       JotunnLib transitively pulls 0Harmony. -->
  <ItemGroup Condition="Exists('$(LibsDir)/bepinex/BepInEx.dll')">
    <Reference Include="BepInEx">
      <HintPath>$(LibsDir)/bepinex/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(LibsDir)/bepinex/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Valheim game assemblies (copied by scripts/fetch-libs.sh into libs/game/).
       Private=false so they aren't copied to mod output (the game provides them).
       Mac build names; Windows differs slightly (assembly_steamworks vs
       com.rlabrecque.steamworks.net) — adjust if a reference fails on your OS. -->
  <ItemGroup Condition="Exists('$(LibsDir)/game/assembly_valheim.dll')">
    <Reference Include="assembly_valheim"          HintPath="$(LibsDir)/game/assembly_valheim.dll"          Private="false" />
    <Reference Include="assembly_utils"            HintPath="$(LibsDir)/game/assembly_utils.dll"            Private="false" />
    <Reference Include="assembly_guiutils"        HintPath="$(LibsDir)/game/assembly_guiutils.dll"        Private="false" />
    <Reference Include="assembly_googleanalytics"  HintPath="$(LibsDir)/game/assembly_googleanalytics.dll"  Private="false" />
    <Reference Include="assembly_postprocessing"   HintPath="$(LibsDir)/game/assembly_postprocessing.dll"   Private="false" />
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(LibsDir)/game/com.rlabrecque.steamworks.net.dll" Private="false" />
  </ItemGroup>

  <!-- All UnityEngine module DLLs from the game (globbed at parse time).
       Private=false so they aren't copied to mod output. -->
  <ItemGroup Condition="Exists('$(LibsDir)/game/assembly_valheim.dll')">
    <Reference Include="$(LibsDir)/game/UnityEngine*.dll" Private="false" />
  </ItemGroup>

</Project>
